{
  "name": "chatgpt-web-skill",
  "version": "0.3.1",
  "private": true,
  "description": "Portable ChatGPT browser delegation skill and CLI with zero-config managed browser or explicit CDP configuration",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/",
    "agents/",
    "lib/",
    "scripts/",
    "MAINTENANCE.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm test",
    "format": "prettier --write \"lib/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "format:check": "prettier --check \"lib/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "format:verify": "prettier --debug-check \"lib/**/*.mjs\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WhatYearIsNow/chatgpt-web-skill.git"
  },
  "homepage": "https://github.com/WhatYearIsNow/chatgpt-web-skill#readme",
  "bugs": {
    "url": "https://github.com/WhatYearIsNow/chatgpt-web-skill/issues"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
