# Set these in your shell. CLI does not automatically load .env files.
# With no endpoint configured, an isolated managed browser is launched
# automatically (its first login persists under the private data directory).
# CHATGPT_WEB_CDP_URL=http://127.0.0.1:9222
# Pure WebSocket endpoints (local relay, Chrome chrome://inspect/#remote-debugging switch
# mode) have no /json/version; they must use the ws:// form, which connects directly.
# CHATGPT_WEB_CDP_URL=ws://127.0.0.1:9333
# CHATGPT_WEB_DATA_DIR=/absolute/private/local/data-directory
# CHATGPT_WEB_BROWSER_MODULE=/absolute/trusted/local/browser-adapter.mjs
# CHATGPT_WEB_CHROME=/absolute/chromium-family/executable
# CHATGPT_WEB_MANAGED=0
# CHATGPT_WEB_TEST_CHROME=/absolute/path/to/chrome
